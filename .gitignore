@'
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
__pycache__/
*.pyc
*.pyo
*.pyd

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
# ...but keep the committed, secret-free example template
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env

# generated audit reports and local outputs
.cursor/audit-reports/
.cursor/audit-reports/**

# Python generated cache
backend-python/__pycache__/
backend-python/**/*.pyc

# raw/generated data exports
**/amazon-raw/**
**/amazon-exports/**
**/report-downloads/**
**/sp-api-downloads/**
data/raw/**
data/exports/**
data/uploads/**
tmp/**
.temp/**
*.csv.gz
*.tsv.gz
*.ndjson.gz
'@ | Set-Content .gitignore -Encoding utf8