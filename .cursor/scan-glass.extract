html.dark .operator-mobile-app-shell .scanner-page-glass-card {
  background-color: rgba(255, 255, 255, 0.05);
  border: 0.5px solid rgba(34, 211, 238, 0.32);
  -webkit-backdrop-filter: blur(24px);
  backdrop-filter: blur(24px);
  box-shadow:
    0 0 0 0.5px rgba(56, 189, 248, 0.12),
    0 0 28px rgba(34, 211, 238, 0.07),
    0 22px 56px -16px rgba(0, 0, 0, 0.68),
    inset 0 1px 0 rgba(255, 255, 255, 0.06);
}

html.light .operator-mobile-app-shell .scanner-page-glass-card {
  background-color: rgba(255, 255, 255, 0.7);
  border: 1px solid #e4e4e7;
  -webkit-backdrop-filter: blur(12px);
  backdrop-filter: blur(12px);
  box-shadow:
    0 12px 44px -12px rgba(0, 0, 0, 0.12),
    0 4px 18px rgba(0, 0, 0, 0.05),
    inset 0 1px 0 rgba(255, 255, 255, 0.92);
}

html.dark .operator-mobile-app-shell .scanner-neon-icon-ring {
  box-shadow:
    0 0 0 1px rgba(34, 211, 238, 0.4),
    0 0 18px rgba(56, 189, 248, 0.55),
    0 0 36px rgba(34, 211, 238, 0.28),
    inset 0 0 14px rgba(56, 189, 248, 0.14);
}

html.light .operator-mobile-app-shell .scanner-neon-icon-ring {
  box-shadow:
    0 0 0 1px rgba(14, 165, 233, 0.35),
    0 6px 22px rgba(14, 165, 233, 0.18);
}

html.dark .operator-mobile-app-shell .scanner-ocr-action-sheet {
  background-color: rgba(255, 255, 255, 0.06);
  border: 0.5px solid rgba(34, 211, 238, 0.38);
  -webkit-backdrop-filter: blur(24px);
  backdrop-filter: blur(24px);
  box-shadow:
    0 0 36px rgba(56, 189, 248, 0.14),
    0 22px 56px rgba(0, 0, 0, 0.58),
    inset 0 1px 0 rgba(255, 255, 255, 0.08);
}

html.light .operator-mobile-app-shell .scanner-ocr-action-sheet {
  background-color: rgba(255, 255, 255, 0.88);
  border: 1px solid #e4e4e7;
  -webkit-backdrop-filter: blur(12px);
  backdrop-filter: blur(12px);
  box-shadow: 0 14px 44px -10px rgba(0, 0, 0, 0.14), 0 6px 20px rgba(0, 0, 0, 0.06);
}

html.dark .operator-mobile-app-shell .scanner-ocr-reading-overlay {
  background-color: rgba(10, 15, 24, 0.82);
  border: 0.5px solid rgba(34, 211, 238, 0.42);
  box-shadow:
    0 0 32px rgba(56, 189, 248, 0.22),
    inset 0 0 28px rgba(45, 212, 191, 0.06);
}

html.light .operator-mobile-app-shell .scanner-ocr-reading-overlay {
  background-color: rgba(255, 255, 255, 0.92);
  border: 1px solid #d4d4d8;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
}

