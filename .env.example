# =============================================================================
# .env.example — secret-free template (NEVER put real secret VALUES here)
# Copy to .env.local (local) or set in the deployment env (Vercel) for LIVE.
# Only the KEYS are documented here; values are placeholders.
# =============================================================================

# --- Supabase (required for any server/script DB access) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# =============================================================================
# Amazon Reports/Finances LIVE SYNC workers
# (PHASE-AMAZON-LIVE-REPORTS-FINANCES-SYNC-WORKERS-V1 +
#  PHASE-AMAZON-INITIAL-LIVE-SOURCE-SYNC-EXECUTE-V1)
#
# All default OFF. The guarded executor will NOT call Amazon until the master
# flag is true AND the operator approval token is set to yes. Never enable via
# NEXT_PUBLIC_*. Accepted truthy values: 1 | true | yes.
# =============================================================================

# Master switch — no Reports API outbound calls when false (REQUIRED first).
ENABLE_AMAZON_REPORTS_API_WORKER=false

# Per-source Reports API flags (each also requires the master flag above):
ENABLE_AMAZON_REPORTS_API_SETTLEMENT=false        # GET_V2_SETTLEMENT_REPORT_DATA_FLAT_FILE_V2
ENABLE_AMAZON_REPORTS_API_REIMBURSEMENTS=false    # GET_FBA_REIMBURSEMENTS_DATA
ENABLE_AMAZON_REPORTS_API_REMOVAL_ORDER=false     # GET_FBA_FULFILLMENT_REMOVAL_ORDER_DETAIL_DATA
ENABLE_AMAZON_REPORTS_API_REMOVAL_SHIPMENT=false  # GET_FBA_FULFILLMENT_REMOVAL_SHIPMENT_DETAIL_DATA
ENABLE_AMAZON_REPORTS_API_FBA_RETURNS=false       # GET_FBA_FULFILLMENT_CUSTOMER_RETURNS_DATA
ENABLE_AMAZON_REPORTS_API_INVENTORY_LEDGER=false  # GET_LEDGER_DETAIL_VIEW_DATA
ENABLE_AMAZON_REPORTS_API_FEE_PREVIEW=false       # GET_FBA_ESTIMATED_FBA_FEES_TXT_DATA
ENABLE_AMAZON_REPORTS_API_INBOUND_PERFORMANCE=false # GET_FBA_FULFILLMENT_INBOUND_PERFORMANCE_DATA

# Finances API (financial events archive) — both required for the finances lane:
ENABLE_AMAZON_FINANCES_API_WORKER=false
ENABLE_AMAZON_FINANCES_API_INGEST=false

# Cron / worker auth — REQUIRED for the worker run + cron routes (set a real
# secret in the deployment env only; keep blank here).
CRON_SECRET=

# --- Amazon SP-API catalog/pricing enrichment lane (already live) ---
# NOTE: this powers PIM catalog/pricing enrichment, NOT the Reports/Finances
# sync workers above. SP-API seller credentials live in the DB
# (marketplaces.credentials: lwa_client_id / lwa_client_secret / refresh_token).
AMAZON_SP_API_ENABLED=true

# =============================================================================
# Operator approval (process gate, NOT an env var)
# Before the initial live source sync can run, set the token to yes in:
#   .cursor/operator-approvals/amazon-initial-live-source-sync-v1-approval.md
#     APPROVED_AMAZON_INITIAL_LIVE_SOURCE_SYNC_V1=yes
# then run:
#   npx tsx scripts/phase-amazon-initial-live-source-sync-execute-v1.ts --execute
# =============================================================================
